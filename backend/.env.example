PORT=5000

# SMTP Connection settings
# Configure Nodemailer standard connection values below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=RoadHelp

# Public frontend URL used inside email links
APP_PUBLIC_URL=http://localhost:5173

# Firebase Service Account Credentials (from Firebase Console -> Project Settings -> Service accounts)
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY_ID=YOUR_PRIVATE_KEY_ID
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=YOUR_CLIENT_ID
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
